<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/perfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PerfilActivity"
    android:orientation="vertical"
    android:background="@color/app_1">

    <RelativeLayout
        android:id="@+id/Container_NavBar_Perfil"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/app_2">

        <Button
            android:id="@+id/btn_Voltar_Perfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:backgroundTint="@color/app_1"
            android:text="Voltar"
            android:textSize="20sp"/>

        <SearchView
            android:id="@+id/search_Filme_Perfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@color/app_1"
            app:queryHint="Pesquisar filmes"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/perfil_Perfil"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:padding="10dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:src="@color/white"/>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/container_Perfil"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:layout_margin="10dp">

        <ImageView
            android:id="@+id/image_Perfil"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:src="@color/white"
            android:scaleType="centerCrop"/>

        <TextView
            android:id="@+id/name_Perfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_toEndOf="@+id/image_Perfil"

            tools:text="Lorem Ipsum"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/date_Perfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Lorem Ipsum"
            android:layout_toEndOf="@id/image_Perfil"
            android:textColor="@color/white"
            android:layout_alignParentEnd="true"
            android:textSize="20sp"

            android:layout_below="@+id/name_Perfil"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btn_Change_Data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/date_Perfil"
            android:layout_alignParentEnd="true"
            android:layout_toEndOf="@id/image_Perfil"
            android:text="Alterar dados"
            android:textSize="20sp"
            android:backgroundTint="@color/app_2"/>

    </RelativeLayout>

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0.1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/text_Filmes_Favoritos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fimes Favoritos"
            android:textColor="@color/white"
            android:textSize="20sp"/>

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/container_Filmes_Favoritos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/filmes_Favoritos"
                    android:layout_width="100dp"
                    android:layout_height="150dp"
                    android:src="@color/white"/>

            </LinearLayout>

        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0.1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filmes Assistidos"
            android:textColor="@color/white"
            android:textSize="20sp"/>

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/container_Filmes_Assistidos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/filmes_Assistidos"
                    android:layout_width="100dp"
                    android:layout_height="150dp"
                    android:src="@color/white"/>

            </RelativeLayout>

        </HorizontalScrollView>
    </LinearLayout>





</LinearLayout>