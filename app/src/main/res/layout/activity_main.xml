<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/app_1"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/container_NavBar_Main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/app_2">

        <Button
            android:id="@+id/btn_Voltar_Main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:backgroundTint="@color/app_1"
            android:text="Voltar"
            android:textSize="20sp"/>

        <SearchView
            android:id="@+id/search_Filmes_Main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@color/app_1"
            app:queryHint="Pesquisar filmes"
            android:layout_centerHorizontal="true"/>
<!--        substituir por imagem-->
        <ImageView
            android:id="@+id/perfil_main"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:padding="10dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:src="@color/white"/>
    </RelativeLayout>

    <HorizontalScrollView
        android:id="@+id/scrol_Generos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2">

        <LinearLayout
            android:id="@+id/container_Generos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/images_Generos"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@color/white"/>
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:id="@+id/scrol_Filmes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8">

        <LinearLayout
            android:id="@+id/container_Filmes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="10dp">
<!--            chamada -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/images_Filmes"
                    android:layout_width="150dp"
                    android:layout_height="250dp"
                    android:src="@color/white"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentBottom="true"/>
                <TextView
                    android:id="@+id/titles_Filmes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:gravity="center"
                    tools:text="Lorem Ipsum"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:textColor="@color/white"
                    android:layout_toEndOf="@+id/images_Filmes"
                    android:layout_marginStart="10dp"/>

                <RatingBar
                    android:id="@+id/avg_Filmes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:progressTint="@color/app_2"
                    android:progressBackgroundTint="@color/star_0"/>
            </RelativeLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>